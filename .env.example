# Goong Maps — lay key tai https://account.goong.io
# Hai key KHAC NHAU, dung dung cho tung muc dich:

# 1) MAPTILES key -> style ban do vector (MapLibre render)
EXPO_PUBLIC_GOONG_MAPTILES_KEY=

# 2) API key -> Directions / Geocoding REST API
EXPO_PUBLIC_GOONG_API_KEY=

# Sau khi dien: sao chep file nay thanh .env roi khoi dong lai Metro
#   npx expo start --clear
